{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Панель керування бібліотекою{% endblock %}

{% block main %}
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-1">Книг у каталозі</h6>
                    <div class="fs-2 fw-bold">{{ bookCount }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-1">Авторів</h6>
                    <div class="fs-2 fw-bold">{{ authorCount }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-1">Доступних примірників</h6>
                    <div class="fs-2 fw-bold">{{ totalCopies }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Швидкі дії</h5>
            <p class="text-muted mb-3">
                Ви увійшли як <strong>{{ app.user.userIdentifier }}</strong> (<code>ROLE_ADMIN</code>).
                Використовуйте меню ліворуч для керування книгами та авторами через EasyAdmin CRUD.
            </p>
            <a href="{{ path('app_home') }}" class="btn btn-outline-primary me-2">Перейти на сайт</a>
            <a href="/api/books" class="btn btn-outline-secondary" target="_blank" rel="noopener">Відкрити JSON API</a>
        </div>
    </div>
{% endblock %}
