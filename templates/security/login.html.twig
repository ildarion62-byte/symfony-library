{% extends 'base.html.twig' %}

{% block title %}Вхід до адмін-панелі{% endblock %}

{% block body %}
    <div class="login-wrapper">
        <div class="login-card">
            <h1>Вхід до адмін-панелі</h1>
            <p class="subtitle">Доступ дозволено лише користувачам із роллю <code>ROLE_ADMIN</code>.</p>

            {% if error %}
                <div class="alert alert-danger" role="alert">
                    Невірний email або пароль ({{ error.messageKey|trans(error.messageData, 'security') }}).
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="login-form">
                <div class="field">
                    <label for="username">Email адміністратора</label>
                    <input
                        type="email"
                        id="username"
                        name="_username"
                        value="{{ last_username }}"
                        autocomplete="email"
                        required
                        autofocus
                        placeholder="admin@library.local"
                    >
                </div>

                <div class="field">
                    <label for="password">Пароль</label>
                    <input
                        type="password"
                        id="password"
                        name="_password"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn-primary">Увійти</button>
            </form>
        </div>
    </div>
{% endblock %}
