<!DOCTYPE html>
<html lang="uk">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Книжкова бібліотека{% endblock %} — Бібліотека Symfony</title>
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <header class="site-header">
            <div class="container header-inner">
                <a href="{{ path('app_home') }}" class="brand">
                    <span class="brand-icon" aria-hidden="true">&#128218;</span>
                    <span>Книжкова бібліотека</span>
                </a>
                <nav class="nav" aria-label="Головна навігація">
                    <a href="{{ path('app_book_index') }}" class="nav-link">Каталог книг</a>
                    <a href="{{ path('app_author_index') }}" class="nav-link">Автори</a>
                    <a href="/api/books" class="nav-link" target="_blank" rel="noopener">JSON API</a>
                    <a href="/admin" class="nav-link nav-admin">Адмінка</a>
                    {% if app.user %}
                        <span class="user-badge">{{ app.user.userIdentifier }}</span>
                        <a href="/logout" class="nav-link nav-logout">Вийти</a>
                    {% else %}
                        <a href="/login" class="nav-link nav-login">Увійти</a>
                    {% endif %}
                </nav>
            </div>
        </header>

        <main class="container main-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container footer-inner">
                <span>Веб-сервіс «Книжкова бібліотека» на Symfony, Doctrine ORM, Twig та EasyAdmin</span>
                <a href="/api/books">API: /api/books</a>
            </div>
        </footer>
    </body>
</html>
